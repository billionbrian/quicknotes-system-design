<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="QuickNotes API client for creating, viewing, and deleting notes.">
  <title>QuickNotes - Notes Manager</title>
  <link rel="stylesheet" href="style.css">
  <script src="api.js" defer></script>
</head>
<body>
  <main class="container">
    <header class="page-header">
      <h1>QuickNotes</h1>
      <p>Create, view, and manage your notes.</p>
    </header>

    <section class="panel" aria-labelledby="notes-heading">
      <h2 id="notes-heading">Your Notes</h2>

      <button id="load-btn" type="button">Load notes</button>

      <p id="status" class="status" role="status" aria-live="polite">
        Click "Load notes" to retrieve notes from the server.
      </p>

      <ul id="notes-list" aria-label="Notes list"></ul>
    </section>

    <section class="panel" aria-labelledby="create-heading">
      <h2 id="create-heading">Create a Note</h2>

      <form id="note-form">
        <div class="form-group">
          <label for="title-input">Title (required, maximum 100 characters)</label>
          <input
            id="title-input"
            name="title"
            type="text"
            maxlength="100"
            required
            autocomplete="off"
          >
        </div>

        <div class="form-group">
          <label for="body-input">Note body (optional)</label>
          <textarea
            id="body-input"
            name="body"
            rows="5"
          ></textarea>
        </div>

        <button id="submit-btn" type="submit">Create note</button>
      </form>
    </section>

    <footer>
      <p>QuickNotes API Client — learning project using JSONPlaceholder.</p>
    </footer>
  </main>
</body>
</html>
