:root {
  font-family: Arial, Helvetica, sans-serif;
  color: #1f2937;
  background: #f3f6fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  line-height: 1.6;
}

.container {
  width: min(900px, 92%);
  margin: 0 auto;
  padding: 32px 0;
}

.page-header {
  margin-bottom: 24px;
}

.page-header h1 {
  margin-bottom: 4px;
  color: #173b70;
  font-size: 2.4rem;
}

.page-header p,
footer p {
  color: #64748b;
}

.panel {
  margin-bottom: 24px;
  padding: 24px;
  background: #ffffff;
  border: 1px solid #dbe3ee;
  border-radius: 12px;
  box-shadow: 0 3px 12px rgb(15 23 42 / 5%);
}

h2 {
  margin-top: 0;
  color: #173b70;
}

button {
  padding: 10px 16px;
  color: #ffffff;
  background: #2458a6;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font: inherit;
  font-weight: 600;
}

button:hover:not(:disabled) {
  background: #173b70;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible {
  outline: 3px solid #93c5fd;
  outline-offset: 2px;
}

button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.status {
  margin: 16px 0;
  padding: 12px;
  border: 1px solid transparent;
  border-radius: 6px;
  overflow-wrap: anywhere;
}

.status-info {
  color: #334155;
  background: #f1f5f9;
  border-color: #cbd5e1;
}

.status-success {
  color: #166534;
  background: #dcfce7;
  border-color: #86efac;
}

.status-error {
  color: #991b1b;
  background: #fee2e2;
  border-color: #fca5a5;
}

#notes-list {
  display: grid;
  gap: 16px;
  padding: 0;
  list-style: none;
}

.note-item {
  padding: 16px;
  border: 1px solid #dbe3ee;
  border-radius: 8px;
  overflow-wrap: anywhere;
}

.note-item h3 {
  margin: 0 0 8px;
  color: #173b70;
}

.note-item p {
  white-space: pre-wrap;
}

.delete-btn {
  background: #b42318;
}

.delete-btn:hover:not(:disabled) {
  background: #8f1d14;
}

.empty-state {
  padding: 20px;
  color: #64748b;
  background: #f8fafc;
  border: 1px dashed #cbd5e1;
  border-radius: 8px;
  text-align: center;
}

.form-group {
  display: grid;
  gap: 6px;
  margin-bottom: 18px;
}

label {
  font-weight: 600;
}

input,
textarea {
  width: 100%;
  padding: 11px;
  font: inherit;
  color: #1f2937;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
}

textarea {
  resize: vertical;
}

footer {
  padding: 12px 0;
  text-align: center;
  font-size: 0.9rem;
}

@media (max-width: 600px) {
  .container {
    width: 94%;
    padding-top: 18px;
  }

  .panel {
    padding: 16px;
  }

  .page-header h1 {
    font-size: 2rem;
  }
}
